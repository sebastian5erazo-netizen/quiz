{% layout 'landing' %}
{% raw %}
<!-- ============================================================
     SERENNA — QUIZ DE DIAGNÓSTICO CAPILAR  ·  v3 (8 pantallas)
     ------------------------------------------------------------
     CAMBIO vs v2 (7 pantallas):
       1. Entra una pregunta NUEVA al inicio: "causa percibida".
          Es la que decide el destino final.
       2. El CTA del intersticial ya NO va siempre a la PDP: cae al
          advertorial que corresponde a la causa que ella eligió
          (6 rutas). Si no hay ruta configurada, cae a la PDP.
       3. Cabecera con degradado vino y el logotipo en imagen
          (antes: fondo blanco con "Serenna" en texto). El logotipo
          se pasa a blanco por CSS para que se lea sobre el
          degradado — ver comentario en el HTML de la cabecera.
     ------------------------------------------------------------
     TIPOGRAFÍA: Zodiak (Fontshare) + IBM Plex Sans (Google). Ambas se
     cargan en landing.liquid, no aquí. Zodiak solo tiene 400 y 700 en los
     pesos que usamos: no existen 500 ni 600.
     ------------------------------------------------------------
     CAMBIA ANTES DE PUBLICAR (bloque CONFIG, al inicio del script):
       RUTAS  -> las 6 URLs de advertorial por causa
     (el logotipo y las imágenes ya quedaron con tus URLs de Shopify)
     ------------------------------------------------------------
     Las pantallas retiradas en v2 siguen en `_archivo-pantallas-v1.txt`.
     La captura de WhatsApp sigue fuera del flujo: para reactivarla,
     agrega {t:"captura"} al final del array PASOS.
     ============================================================ -->


<style>
:root{
  --vino:#541005; --vino-soft:#7F1201; --rosa:#FFB5B5; --avena:#FFFFFF;
  --rubor:#FBF0EF; --salvia:#7F1201; --tinta:#000000; --linea:#FBF0EF;
  --tenue:rgba(84,16,5,.62); --tenue2:rgba(84,16,5,.35);
  --serif:"Zodiak",Georgia,serif; --sans:"IBM Plex Sans",system-ui,sans-serif;
}
.snq *{box-sizing:border-box;margin:0;padding:0}
.snq{font-family:var(--sans);color:var(--tinta);background:var(--avena);
  min-height:100vh;-webkit-font-smoothing:antialiased;line-height:1.55}

.snq-top{position:sticky;top:0;z-index:20;background:var(--avena);
  border-bottom:1px solid var(--linea)}
.snq-top .band{background:var(--avena)}
.snq-top.grad .band{background:linear-gradient(130deg,var(--vino-soft),var(--rosa))}
.snq-top .row{max-width:520px;margin:0 auto;padding:10px 22px;
  padding-top:calc(10px + env(safe-area-inset-top));
  display:flex;align-items:center;gap:14px}
.snq-back{background:none;border:none;cursor:pointer;padding:4px;
  font-size:22px;color:var(--vino);line-height:1;opacity:.75;transition:.15s}
.snq-top.grad .snq-back{color:#fff;opacity:.9}
.snq-back:hover{opacity:1;transform:translateX(-2px)}
.snq-back[hidden]{visibility:hidden;display:block}
.snq-logo{font-family:var(--serif);font-weight:700;font-size:19px;
  color:var(--vino);letter-spacing:-.01em}
.snq-top.grad .snq-logo{color:#fff}
.snq-logo-img{display:block;height:26px;width:auto;object-fit:contain}
/* El logotipo es vino sobre transparente: sobre el degradado no se leería.
   Este filtro lo pasa a blanco. Si algún día subes un PNG del logo ya en
   blanco, borra la línea de abajo. */
.snq-top.grad .snq-logo-img{filter:brightness(0) invert(1)}
.snq-prog{height:2px;background:var(--linea)}
.snq-prog i{display:block;height:100%;background:var(--vino);width:0;
  transition:width .4s ease}

.snq-stage{max-width:520px;margin:0 auto;
  padding:34px 22px calc(70px + env(safe-area-inset-bottom))}
.snq-step{animation:fade .28s ease}
@keyframes fade{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}

.snq h2{font-family:var(--serif);font-weight:400;
  font-size:clamp(24px,6.6vw,28px);line-height:1.16;
  letter-spacing:-.018em;color:var(--vino);text-wrap:pretty}
.snq .sub{font-size:15.5px;color:var(--tenue);margin-top:9px;text-wrap:pretty}
.snq .body{font-size:17px;color:var(--tinta);margin-top:18px;text-wrap:pretty}
.snq .body em{font-style:normal;color:var(--vino);font-weight:500}

.snq-foto{margin-top:20px;border-radius:6px;overflow:hidden;background:var(--rubor)}
.snq-foto img{display:block;width:100%;height:150px;object-fit:cover}

.snq-opts{display:flex;flex-direction:column;gap:10px;margin-top:24px}
.snq-opt{display:flex;align-items:center;justify-content:space-between;gap:12px;
  width:100%;text-align:left;background:var(--rubor);
  border:1px solid var(--linea);border-radius:4px;padding:15px 16px;
  cursor:pointer;font-family:var(--sans);font-size:16px;color:var(--tinta);
  transition:border-color .15s,background .15s}
.snq-opt:hover{border-color:var(--vino-soft)}
.snq-opt:focus-visible{outline:2px solid var(--vino);outline-offset:2px}
.snq-opt .txt b{display:block;font-size:16px;font-weight:400}
.snq-opt .txt b.tit{font-weight:600}
.snq-opt .txt span{display:block;font-size:13.5px;color:var(--tenue);margin-top:2px}
.snq-opt .box{flex:none;width:20px;height:20px;border-radius:4px;
  border:1.5px solid var(--tenue2);position:relative;transition:.15s}
.snq-opt[aria-pressed="true"]{background:#fff;border:1.5px solid var(--vino)}
.snq-opt[aria-pressed="true"] .box{background:var(--vino);border-color:var(--vino)}
.snq-opt[aria-pressed="true"] .box::after{content:"";position:absolute;
  left:6px;top:2.5px;width:4px;height:9px;border:solid #fff;
  border-width:0 2px 2px 0;transform:rotate(45deg)}

.snq-why{background:var(--rubor);border-radius:4px;padding:16px 17px;margin-top:20px}
.snq-why h4{font-family:var(--serif);font-size:15.5px;font-weight:700;
  color:var(--vino);margin-bottom:6px}
.snq-why p{font-size:13.5px;color:var(--tinta);line-height:1.5}

.snq-cta{display:block;width:100%;text-align:center;background:var(--vino);
  color:#fff;border:none;border-radius:999px;padding:16px 20px;margin-top:26px;
  font-family:var(--sans);font-size:16px;font-weight:600;cursor:pointer;
  text-decoration:none;transition:background .15s}
.snq-cta:hover{background:var(--vino-soft);color:#fff}
.snq-cta:disabled{background:var(--linea);color:var(--tenue2);cursor:not-allowed}
.snq-cta:focus-visible{outline:2px solid var(--vino);outline-offset:3px}
.snq-skip{display:block;width:100%;text-align:center;background:none;border:none;
  margin-top:15px;font-family:var(--sans);font-size:14px;color:var(--tenue);
  text-decoration:underline;cursor:pointer}
.snq-nota{font-size:12.5px;color:var(--tenue);text-align:center;margin-top:14px}
.snq-debug{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;
  line-height:1.5;color:var(--vino);background:var(--rubor);border-radius:4px;
  padding:12px 13px;margin-top:18px;word-break:break-all}

/* Campos — solo los usa la pantalla de captura (fuera del flujo) */
.snq-field{margin-top:22px}
.snq-field label{display:block;font-size:13px;font-weight:600;
  color:var(--vino-soft);margin-bottom:7px}
.snq-field input{width:100%;font-family:var(--sans);font-size:16px;
  padding:15px 16px;border:1px solid var(--linea);border-radius:4px;
  background:var(--rubor);color:var(--tinta)}
.snq-field input:focus{outline:2px solid var(--vino);outline-offset:-1px}
.snq-err{font-size:13px;color:#A33B3B;margin-top:8px;display:none}
.snq-err.on{display:block}
.snq-fine{font-size:12.5px;color:var(--tenue);margin-top:16px;line-height:1.5}
.snq-center{text-align:center}
.snq-center h2{font-size:clamp(26px,7.4vw,31px)}
.snq-center .snq-field{text-align:left}

@media (prefers-reduced-motion:reduce){.snq *{animation:none!important;transition:none!important}}
</style>

<div class="snq">

  <!-- CABECERA
       El logotipo se cambia aquí mismo, en el src del <img>.
       Si el archivo no carga, cae solo a "Serenna" en texto.

       La cabecera va con el degradado vino del storyboard (clase "grad").
       Como el logotipo es vino sobre transparente, el CSS lo pasa a blanco
       con un filtro para que se lea. Si prefieres cabecera clara con el
       logotipo en su color original, quita "grad" de la línea de abajo. -->
  <div class="snq-top grad">
    <div class="band">
      <div class="row">
        <button class="snq-back" id="snqBack" aria-label="Volver">&#8249;</button>
        <span id="snqMarca"><img class="snq-logo-img" id="snqLogo" alt="Serenna"
          src="https://cdn.shopify.com/s/files/1/0767/8292/8103/files/unnamed.png?v=1787677897"></span>
      </div>
    </div>
    <div class="snq-prog"><i id="snqProg"></i></div>
  </div>
  <div class="snq-stage" id="snqStage"></div>
</div>

<script>
(function(){
/* ==========================================================
   CONFIG
   ========================================================== */
var DESTINO   = "https://serenna.lat/products/serenna-40";  // fallback si no hay ruta

/* Destino por causa percibida (pantalla 01).
   El "key" de cada URL es la llave de acceso de ESA página: no se puede
   quitar ni intercambiar mientras las páginas sigan sin publicar.
   Cuando las publiques, puedes dejar la URL limpia (sin "?_ab=0&key=..."). */
var RUTAS = {
  menopausia:      "https://serenna.lat/pages/adv-menopausia?_ab=0&key=1787623189625",
  ciclo:           "https://serenna.lat/pages/adv-ciclo-mestrual?_ab=0&key=1787676398201",
  estres:          "https://serenna.lat/pages/adv-estres?_ab=0&key=1787676559654",
  desnutricion:    "https://serenna.lat/pages/adv-desnutricion?_ab=0&key=1787676607217",
  anticonceptivos: "https://serenna.lat/pages/adv-anticonceptivos?_ab=0&key=1787676516715",
  alopecia:        "https://serenna.lat/pages/adv-alopecia-androgenica?_ab=0&key=1787676448180"
};

/* El logotipo NO se configura aquí: está en el <img id="snqLogo"> de la cabecera,
   arriba en el HTML. Se dejó ahí para que pinte de inmediato, sin esperar al JS. */
var IMG_ZONAS       = "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/Women_s_hair_loss_locations_anim__202608021713.webp?v=1785720795";
var IMG_PRODUCTO    = "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/MES_0_1.webp?v=1785720795";   // solo lo usan las pantallas archivadas
var MOSTRAR_POR_QUE = true; // recuadros "¿Por qué preguntamos?"
var PEDIR_WHATSAPP  = true; // sin efecto: la pantalla de captura está fuera del flujo
var PERMITIR_SALTAR = true; // sin efecto: la pantalla de captura está fuera del flujo

/* ==========================================================
   FLUJO — 8 pantallas (7 preguntas + intersticial)
   ========================================================== */
var PASOS = [

 /* PANTALLA 01 — la única que tiene "r": define la ruta de salida. */
 {t:"single", id:"causa", q:"¿Cuál de estas causas crees que es la causante de tu caída de cabello?", o:[
   {v:"menopausia",      r:"menopausia",      x:"Menopausia"},
   {v:"ciclo",           r:"ciclo",           x:"Ciclo menstrual"},
   {v:"estres",          r:"estres",          x:"Estrés"},
   {v:"desnutricion",    r:"desnutricion",    x:"Desnutrición folicular"},
   {v:"anticonceptivos", r:"anticonceptivos", x:"Anticonceptivos"},
   {v:"alopecia",        r:"alopecia",        x:"Alopecia androgenética"}]},

 {t:"single", id:"situacion", q:"¿Qué describe mejor tu situación?", o:[
   {v:"frenar",   x:"Estoy notando caída y quiero frenarla"},
   {v:"densidad", x:"Perdí densidad y quiero recuperarla"},
   {v:"quemada",  x:"Llevo años con esto y ya probé de todo"},
   {v:"prevenir", x:"Todavía no se nota mucho, quiero prevenir"},
   {v:"ninguna",  x:"Ninguna de las anteriores"}]},

 {t:"single", id:"zona", q:"¿Dónde estás notando la caída?", img:"zonas", o:[
   {v:"particion", x:"En la partidura, se ve más ancha"},
   {v:"coronilla", x:"En la coronilla"},
   {v:"sienes",    x:"En las entradas y las sienes"},
   {v:"difusa",    x:"Por todo el cuero cabelludo"}]},

 {t:"single", id:"cantidad", q:"¿Cuánto cabello sientes que has perdido?", o:[
   {v:"mucho", x:"Mucho", s:"Ya es evidente para los demás"},
   {v:"algo",  x:"Algo",  s:"Las personas cercanas lo notan"},
   {v:"poco",  x:"Poco",  s:"Por ahora solo lo noto yo"}]},

 {t:"single", id:"tipo", q:"¿Cómo es tu cabello?", o:[
   {v:"liso",   x:"Liso u ondulado"},
   {v:"rizado", x:"Rizado o crespo"},
   {v:"tenido", x:"Teñido o con químicos"},
   {v:"fino",   x:"Muy fino o quebradizo"}]},

 {t:"single", id:"familia", q:"¿Hay caída de cabello en tu familia?", o:[
   {v:"si",   x:"Sí"},
   {v:"no",   x:"No"},
   {v:"nose", x:"No estoy segura"}],
  why:{h:"¿Por qué preguntamos?", p:"La predisposición familiar es uno de los factores más frecuentes en la caída femenina. Saberlo nos ayuda a ajustar la constancia que va a necesitar tu rutina."}},

 {t:"single", id:"estres", q:"¿Con qué frecuencia sientes estrés?", o:[
   {v:"casi_nunca", x:"Casi nunca"},
   {v:"a_veces",    x:"A veces"},
   {v:"siempre",    x:"Todo el tiempo"},
   {v:"nose",       x:"No sabría decir"}],
  why:{h:"¿Por qué preguntamos?", p:"Los periodos de estrés sostenido pueden alterar el ciclo capilar y aumentar la caída de forma temporal. Es una de las causas más comunes y también de las más reversibles."}},

 /* PANTALLA FINAL — al ser el último paso, el CTA se renderiza como
    <a> real hacia la ruta que salió de la pantalla 01. */
 {t:"mensaje", titulo:"Buenas noticias",
  cuerpo:"Con lo que nos contaste ya podemos <em>armar tu rutina</em>.",
  cta:"Ver lo que sabemos de mi cabello",
  nota:"Tarda menos de un minuto."}

];

/* ========================================================== */
var i = 0, R = {}, RUTA = null, stage, back, prog;

function px(ev,d){ if(typeof fbq==='function'){ try{ fbq('trackCustom',ev,d||{}); }catch(e){} } }
function esc(s){ return String(s).replace(/[&<>"]/g,function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
function foto(cual){
  var u = cual==='zonas' ? IMG_ZONAS : IMG_PRODUCTO;
  return u ? '<div class="snq-foto"><img src="'+esc(u)+'" alt=""></div>' : '';
}
function base(){ return (RUTA && RUTAS[RUTA]) ? RUTAS[RUTA] : DESTINO; }
/* Diagnóstico: abre la página con ?debug=1 al final de la URL y la pantalla
   final te muestra la causa elegida y el destino exacto. Sirve para saber si
   el quiz está mandando bien o si el problema está en las páginas de destino. */
function debugOn(){ return /[?&]debug=1/.test(window.location.search); }
/* Parámetros que NO se heredan de la página del quiz: son llaves de acceso
   y datos de vista previa que pertenecen a ESTA página, no al destino.
   Si se copiaran, el enlace saldría con dos "key" y Shopify se quedaría con
   el equivocado — que fue justo lo que mandaba todo a la misma landing. */
var NO_HEREDAR = ['_ab','key','_fd','_sc','preview_theme_id','password','pb'];

function url(){
  var b = base(), u;
  try { u = new URL(b, window.location.origin); }
  catch(e){ return b; }

  // Conserva utm_*, fbclid, gclid… de la visita, sin pisar lo que ya trae el destino
  var entrada = new URLSearchParams(window.location.search);
  entrada.forEach(function(v,k){
    if(NO_HEREDAR.indexOf(k) > -1) return;
    if(u.searchParams.has(k)) return;
    u.searchParams.set(k, v);
  });

  for(var k in R){
    if(R[k]) u.searchParams.set(k, Array.isArray(R[k]) ? R[k].join('|') : R[k]);
  }
  return u.toString();
}
function cerrar(){
  try{ localStorage.setItem('serenna_quiz', JSON.stringify(R)); }catch(e){}
  px('QuizCompletado', Object.assign({ruta: RUTA || 'pdp'}, R));
}
function salir(){ cerrar(); window.location.href = url(); }
function ir(n){
  i = n;
  if(i >= PASOS.length){ return salir(); }
  render();
  window.scrollTo({top:0,behavior:'auto'});
}
function avanzar(){ ir(i+1); }

function render(){
  var p = PASOS[i];
  back.hidden = (i === 0);
  prog.style.width = Math.round(((i+1) / PASOS.length) * 100) + '%';
  stage.innerHTML = '';
  var d = document.createElement('div');
  d.className = 'snq-step';
  (VISTAS[p.t] || VISTAS.mensaje)(d, p);
  stage.appendChild(d);
}

var VISTAS = {

 single: function(d,p){
   d.innerHTML = '<h2>'+esc(p.q)+'</h2>'
     + (p.sub ? '<p class="sub">'+esc(p.sub)+'</p>' : '')
     + (p.img ? foto(p.img) : '')
     + '<div class="snq-opts">' + p.o.map(function(o){
         return '<button class="snq-opt" data-v="'+o.v+'"'+(o.r?' data-r="'+o.r+'"':'')+'>'
              + '<span class="txt"><b'+(o.s?' class="tit"':'')+'>'+esc(o.x)+'</b>'
              + (o.s ? '<span>'+esc(o.s)+'</span>' : '') + '</span><span class="box"></span></button>';
       }).join('') + '</div>'
     + (p.why && MOSTRAR_POR_QUE ? '<div class="snq-why"><h4>'+esc(p.why.h)+'</h4><p>'+esc(p.why.p)+'</p></div>' : '');

   d.querySelectorAll('.snq-opt').forEach(function(b){
     b.setAttribute('aria-pressed', R[p.id] === b.dataset.v ? 'true' : 'false');
     b.addEventListener('click', function(){
       R[p.id] = b.dataset.v;
       if(b.dataset.r){ RUTA = b.dataset.r; }
       d.querySelectorAll('.snq-opt').forEach(function(o){ o.setAttribute('aria-pressed','false'); });
       b.setAttribute('aria-pressed','true');
       px('QuizRespuesta',{pregunta:p.id, respuesta:b.dataset.v});
       setTimeout(avanzar, 190);
     });
   });
 },

 multi: function(d,p){
   var sel = [];
   d.innerHTML = '<h2>'+esc(p.q)+'</h2>'
     + (p.sub ? '<p class="sub">'+esc(p.sub)+'</p>' : '')
     + '<div class="snq-opts">' + p.o.map(function(o){
         return '<button class="snq-opt" data-v="'+o.v+'"><span class="txt"><b>'+esc(o.x)+'</b></span><span class="box"></span></button>';
       }).join('') + '</div>'
     + '<button class="snq-cta" disabled>Continuar</button>';
   var cta = d.querySelector('.snq-cta');
   d.querySelectorAll('.snq-opt').forEach(function(b){
     b.setAttribute('aria-pressed','false');
     b.addEventListener('click', function(){
       var v = b.dataset.v, k = sel.indexOf(v);
       if(k>-1){ sel.splice(k,1); b.setAttribute('aria-pressed','false'); }
       else { sel.push(v); b.setAttribute('aria-pressed','true'); }
       cta.disabled = sel.length === 0;
     });
   });
   cta.addEventListener('click', function(){
     R[p.id] = sel;
     px('QuizRespuesta',{pregunta:p.id, respuesta:sel.join('|')});
     avanzar();
   });
 },

 /* Si es el último paso del flujo, el CTA sale como <a> real hacia la
    ruta elegida: aunque el handler de JS fallara, el enlace navega igual.
    Si no es el último, se comporta como botón de "Continuar". */
 mensaje: function(d,p){
   var ultimo = (i === PASOS.length - 1);
   var texto  = esc(p.cta || 'Continuar');
   d.innerHTML = '<h2>'+esc(p.titulo)+'</h2><p class="body">'+p.cuerpo+'</p>'
     + (ultimo
         ? '<a class="snq-cta" href="'+esc(url())+'">'+texto+'</a>'
         : '<button class="snq-cta">'+texto+'</button>')
     + (p.nota ? '<p class="snq-nota">'+esc(p.nota)+'</p>' : '')
     + (ultimo && debugOn()
         ? '<p class="snq-debug"><b>causa:</b> '+esc(RUTA||'(ninguna)')+'<br><b>destino:</b> '+esc(base())+'</p>'
         : '');
   if(ultimo){ try{ console.log('[quiz] causa:', RUTA, '| destino:', base()); }catch(e){} }
   d.querySelector('.snq-cta').addEventListener('click', ultimo ? cerrar : avanzar);
 },

 /* Pantalla de captura de WhatsApp — fuera del flujo.
    Para reactivarla, agrega {t:"captura"} al final del array PASOS. */
 captura: function(d){
   if(!PEDIR_WHATSAPP) return salir();
   d.className = 'snq-step snq-center';
   d.innerHTML = '<h2>Tu rutina está lista</h2>'
     + '<p class="sub">Déjanos tu WhatsApp y te la mostramos. Te escribimos solo para acompañarte con tu rutina.</p>'
     + '<div class="snq-field"><label for="snqTel">Número de WhatsApp</label>'
     + '<input id="snqTel" type="tel" inputmode="numeric" autocomplete="tel" placeholder="300 123 4567" maxlength="14"></div>'
     + '<p class="snq-err" id="snqErr">Escribe un número de celular de 10 dígitos.</p>'
     + '<button class="snq-cta">Ver mi rutina</button>'
     + (PERMITIR_SALTAR ? '<button class="snq-skip">Prefiero verla sin dejar mis datos</button>' : '')
     + '<p class="snq-fine">Medicamento de venta libre. Lea cuidadosamente las indicaciones y contraindicaciones. Si los síntomas persisten, consulte a su médico.</p>';

   var tel = d.querySelector('#snqTel'), err = d.querySelector('#snqErr');
   d.querySelector('.snq-cta').addEventListener('click', function(){
     var n = (tel.value||'').replace(/\D/g,'');
     if(n.length !== 10){ err.classList.add('on'); tel.focus(); return; }
     err.classList.remove('on');
     R.tel = n;
     px('Lead',{contenido:'quiz_capilar'});
     salir();
   });
   tel.addEventListener('keydown', function(e){ if(e.key === 'Enter') d.querySelector('.snq-cta').click(); });
   var skip = d.querySelector('.snq-skip');
   if(skip) skip.addEventListener('click', function(){ px('QuizSaltoCaptura'); salir(); });
 }
};

function boot(){
  stage = document.getElementById('snqStage');
  back  = document.getElementById('snqBack');
  prog  = document.getElementById('snqProg');
  if(!stage || !back || !prog){ return setTimeout(boot, 120); }
  if(stage.getAttribute('data-listo')) return;
  stage.setAttribute('data-listo','1');
  var lg = document.getElementById('snqLogo');
  if(lg){
    var alTexto = function(){
      var m = document.getElementById('snqMarca');
      if(m) m.innerHTML = '<span class="snq-logo">Serenna</span>';
    };
    lg.addEventListener('error', alTexto);
    if(lg.complete && lg.naturalWidth === 0) alTexto();
  }
  back.addEventListener('click', function(){ if(i>0) ir(i-1); });
  px('QuizIniciado');
  render();
}
if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', boot); }
else { boot(); }
})();
</script>

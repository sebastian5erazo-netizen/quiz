    "gp_section_631665723264992184": {
      "type": "gp-section-631665723264992184",
      "settings": {
        "checksum": "b9c595edbab85f4b3151e0e90f80b9d8d34650b774ec36069cd212f5917fb9b9_1_1_1_0__1",
        "ggz36OeV9a4_text": "<p>Preguntas Frecuentes</p>",
        "gg3C6ecuM9k_childItem_0": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Cómo se toma?</span></p>",
        "gg3C6ecuM9k_childItem_1": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Cuándo recibiré mi pedido?&nbsp;</span></p>",
        "gg3C6ecuM9k_childItem_2": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Cuándo puedo ver resultados?</span></p>",
        "gg3C6ecuM9k_childItem_3": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Está avalado por el INVIMA?</span></p>",
        "gg3C6ecuM9k_childItem_4": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Tiene efectos secundarios?</span></p>",
        "gg3C6ecuM9k_childItem_5": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Se puede tomar durante el embarazo o lactancia?</span></p>",
        "ggPtu5puoot_text": "<p><span style=\"background-color:transparent;font-size:14px;\">Dos capsulas al día, una en la mañana despues del desayuno, la siguiente despues de la cena, antes de acostarse a dormir.</span></p>",
        "ggOP1TrYnrf_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(33,25,22);font-size:14px;\">El tiempo medio para recibir el pedido es de 48 horas laborables. Para envíos a las ciudades que no sean las principales de Colombia, el tiempo estimado es de 3 a 5 días laborables.</span></p>",
        "ggw5hrhEYe5_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(33,25,22);font-size:14px;\">Nuestros usuarios reportan un que ven los resultados notables en la semana 7 de uso constante.</span></p>",
        "ggr4U_nbWpC_text": "<p><span style=\"background-color:transparent;font-size:inherit;\">Serenna es avalado por el decreto 3554 de 2004 y el decreto 1737 de 2005.</span></p>",
        "gg7Js-smtZY_text": "<p><span style=\"background-color:transparent;font-size:inherit;\">Serenna no contiene efectos secundarios, no tiene azucares, químicos, minoxidil, es libre de gluten, asi que no se presentan contraindicaciones.</span></p>",
        "gg51AZS-GhA_text": "<p><span style=\"background-color:transparent;font-size:inherit;\">Es seguro tomarlo después del tercer mes de embarazo, sin embargo se recomienda supervisión médica.</span></p>",
        "ggf7NYcuAs0_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/WhatsApp_Image_2026-04-21_at_4.33.52_PM_1.webp?v=1780624424"
      }
    }

        "ggv7InUPlxw_label": "<p><span style=\"color:#FBF0EF;\">DÍA 1: Regulación capilar</span></p>",
        "ggGtk5f_Nmp_text": "<p><strong>73% de las clientas</strong> sienten cambios en la primera semana</p>",
        "ggsB_cqBr_R_label": "<p>DÍA 15: Mejora notable</p>",
        "ggn00FVjEmx_text": "<p><strong>91% de las clientas</strong> reportan mejorar consistente en su cabello a la semana 2.</p>",
        "ggp6O6bXAVj_label": "<p><span style=\"color:#FBF0EF;\">DÍA 30: Consolidación del foliculo</span></p>",
        "gg3k5vVgY_V_text": "<p><strong>89% de las clientas</strong> reportan un cabelo mas fuerte, abundante y luminoso.</p>",
        "gg5QmVO4324_label": "<p><span style=\"color:#FBF0EF;\">DÍA 45: Fase de matenimiento</span></p>",

    "gp_section_631255186400281477": {
      "type": "gp-section-631255186400281477",
      "settings": {
        "checksum": "d1682c380c4533c0ebbcc0eec80551724a57951bb3376ff4b1ead1d52ffc7eb8_1_1_1_0__1",
        "ggk3ESOXZsS_text": "LO QUE HAY ADENTRO",
        "ggXsW08_ZbA_text": "es lo que importa",
        "ggx0cq34Hzf_label": "<p><u>Información nutricional</u> →</p>",
        "gg-_BM_5ntu_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_1.svg?v=1785434724",
        "gg-_BM_5ntu_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_8.webp?v=1786036008",
        "gg95fGMDrxB_text": "SAW PALMETTO",
        "gg7k0wRWNjk_text": "<span style=\"background-color:rgba(217,234,211,0);color:#7F1201;\">&nbsp;Ayuda a bloquear la enzima&nbsp;<i>5-alfa reductasa</i>, que convierte la testosterona en&nbsp;<strong>DHT</strong> (dihidrotestosterona), la hormona responsable de miniaturizar y debilitar el folículo piloso.</span>",
        "ggEZ32_vndm_text": "<p><strong>80 mg</strong></p>",
        "ggBqxkaAj3__srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_4.svg?v=1785434724",
        "ggBqxkaAj3__srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_11.webp?v=1786036008",
        "ggGI_mpWvqA_text": "COLA DE CABALLO",
        "ggTrXtQQUrJ_text": "<span style=\"background-color:rgba(217,234,211,0);color:#7F1201;\">Extremadamente rica en&nbsp;<strong>silicio</strong> orgánico. &nbsp;Da brillo y grosor al cabello. Además, tiene un ligero efecto diurético (ayuda a eliminar toxinas en el cuero cabelludo).</span>",
        "ggWPiTAMBHz_text": "<p><strong>70 mg</strong></p>",
        "ggiHWFixBil_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_2.svg?v=1785434723",
        "ggiHWFixBil_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_9.webp?v=1786036007",
        "gguYIiRs-AN_text": "SELENIO (romero)&nbsp;",
        "ggXykWw9zqv_text": "<span style=\"background-color:rgba(217,234,211,0);color:#7F1201;\">Un mineral esencial que protege a las células del daño causado por los radicales libres. Crucial para el buen funcionamiento de la tiroides, que causa caída de cabello de inmediato.</span>",
        "gg058tUcucn_text": "<p><strong>60 mg</strong></p>",
        "ggAeTIHdLED_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_6.svg?v=1785434723",
        "ggAeTIHdLED_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_13.webp?v=1786036007",
        "ggjiO8pBI-E_text": "CURCUMA&nbsp;",
        "ggh3aoeQLAW_text": "<span style=\"background-color:rgba(217,234,211,0);color:#7F1201;\">Antinflamatorio y antioxidante natural. La microinflamación en el cuero cabelludo suele estar detrás de muchos problemas de caída y debilidad capilar.</span>",
        "ggwPsVgVzXo_text": "<p><strong>80 mg</strong></p>",
        "ggSHXOViXEa_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_5.svg?v=1785434724",
        "ggSHXOViXEa_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_12.webp?v=1786036007",
        "ggPbdzizco9_text": "ASHWAGANDHA",
        "ggjYWTChimh_text": "<span style=\"background-color:rgba(217,234,211,0);color:#7F1201;\"><strong>Baja los niveles de cortisol</strong> . El estrés crónico altera el ciclo del cabello, empujándolo prematuramente a la fase de caída (efluvio telógeno). Al controlar el estrés, proteges tu pelo.</span>",
        "ggifXUdsplT_text": "<p><strong>80 mg</strong></p>",
        "ggGy8yfsG3P_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_1e3abf4d-486b-4092-86fd-d587f87c4d68.svg?v=1785434726",
        "ggGy8yfsG3P_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_7_1.webp?v=1786036007",
        "ggnL5jsnDLr_text": "PEPTIDOS DE COLAGENO&nbsp;",
        "ggdhsFglMGJ_text": "<span style=\"background-color:rgba(217,234,211,0);color:#7F1201;\">Son aminoácidos ya desglosados que el cuerpo absorbe fácilmente para aportar los nutrientes que el folículo piloso necesita para producir un cabello fuerte.</span>",
        "ggLv2pIzx0x_text": "<p><strong>150 mg</strong></p>",
        "ggy_pc6Xfkt_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_3.svg?v=1785434725",
        "ggy_pc6Xfkt_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_10.webp?v=1786036007",
        "ggOEhCGCp69_text": "L-CISTEINA",
        "ggo3g3os2LK_text": "<span style=\"background-color:rgba(127, 18, 1, 0);color:#7F1201;\">Es un aminoácido fundamental porque forma parte de la&nbsp;<strong>queratina</strong>, que es la proteína que compone el 90% de tu cabello y uñas. Ayuda a que el pelo sea más resistente a las roturas.</span>",
        "ggXmjLz4DnG_text": "<p><strong>100 mg</strong></p>",
        "gg8rzG6y-EL_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_7.svg?v=1785434724",
        "gg8rzG6y-EL_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_14.webp?v=1786036007",
        "ggMG5YsCIGM_text": "BIOTINA ( B7)",
        "gg7EU-Ve2Ep_text": "<span style=\"background-color:rgba(217, 234, 211, 0);color:#7F1201;\">Ayuda a metabolizar aminoácidos para que el cuerpo pueda producir queratina de manera eficiente. Una deficiencia de biotina debilita el pelo y descama las uñas.</span>",
        "ggf24w6w_0I_text": "<p><strong>70 mg</strong></p>"
      }
    },

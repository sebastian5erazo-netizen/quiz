        "gg_Tx1HwEN5_text": "Doris Valencia.",
        "gg8e6VZNWmj_text": "<p>\"Siempre les digo a mis pacientas que no esperen milagros. Con Serenna al menos tienen garantía de resultados y eso les da confianza.\"</p>",
        "ggLgCSFK5Sh_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/verificar.png?v=1785451553",

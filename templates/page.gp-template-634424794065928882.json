        "ggejZJXZFFq_text": "Laura T.",
        "gg3SKtpuDAg_text": "<p>\"Apenas llevo 2 semanas tomándolas, pero inmediatamente me ha frenado la caída del pelo.\"</p>",
        "ggt4UNq1wpd_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/verificar.png?v=1785451553",
        "gg0FBBAlycT_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/Woman_taking_close-up_selfie_202607301742.webp?v=1785451389",
        "ggxAjpKPoqj_text": "Andrea.M",
        "ggp3rkiFNZw_text": "<p>\"Mis pacientas ya habían probaron shampoos, ampollas, minoxidil. Esta marca les SALVO la vida.\"</p>",
        "gg4cpiGn73c_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/verificar.png?v=1785451553",

        "ggWPiTAMBHz_text_515951835": "70 mg",
        "ggiHWFixBil_srcSet_desktop_src_-948877572": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_2.svg?v=1785434723",
        "ggiHWFixBil_srcSet_mobile_src_-408510062": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_9.webp?v=1786036007",
        "gguYIiRs-AN_text_1482314767": "SELENIO (romero)&nbsp;",
        "ggXykWw9zqv_text_400237557": "Un mineral esencial que protege a las células del daño causado por los radicales libres. Crucial para el buen funcionamiento de la tiroides, que causa caída de cabello de inmediato.",
        "gg058tUcucn_text_597747051": "60 mg",
        "ggAeTIHdLED_srcSet_desktop_src_-858156550": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_6.svg?v=1785434723",
        "ggAeTIHdLED_srcSet_mobile_src_-1781826194": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_13.webp?v=1786036007",
        "ggjiO8pBI-E_text_953070881": "CURCUMA&nbsp;",
        "ggh3aoeQLAW_text_914510573": "Antinflamatorio y antioxidante natural. La microinflamación en el cuero cabelludo suele estar detrás de muchos problemas de caída y debilidad capilar.",
        "ggwPsVgVzXo_text_-1668261110": "80 mg",
        "ggSHXOViXEa_srcSet_desktop_src_-1204037317": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_5.svg?v=1785434724",
        "ggSHXOViXEa_srcSet_mobile_src_1110048054": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_12.webp?v=1786036007",
        "ggPbdzizco9_text_-1269130575": "ASHWAGANDHA",
        "ggjYWTChimh_text_2139808373": "<strong>Baja los niveles de cortisol</strong> . El estrés crónico altera el ciclo del cabello, empujándolo prematuramente a la fase de caída (efluvio telógeno). Al controlar el estrés, proteges tu pelo.",
        "ggifXUdsplT_text_-1668261110": "80 mg",
        "ggGy8yfsG3P_srcSet_desktop_src_225968797": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_1e3abf4d-486b-4092-86fd-d587f87c4d68.svg?v=1785434726",
        "ggGy8yfsG3P_srcSet_mobile_src_-1026377994": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_7_1.webp?v=1786036007",
        "ggnL5jsnDLr_text_-1385804310": "PEPTIDOS DE COLAGENO&nbsp;",
        "ggdhsFglMGJ_text_1369777999": "Son aminoácidos ya desglosados que el cuerpo absorbe fácilmente para aportar los nutrientes que el folículo piloso necesita para producir un cabello fuerte.",
        "ggLv2pIzx0x_text_-590996211": "150 mg",
        "ggy_pc6Xfkt_srcSet_desktop_src_-1052748504": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_3.svg?v=1785434725",
        "ggy_pc6Xfkt_srcSet_mobile_src_916323271": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_10.webp?v=1786036007",
        "ggOEhCGCp69_text_-1726348905": "L-CISTEINA",
        "ggo3g3os2LK_text_-1570979195": "Es un aminoácido fundamental porque forma parte de la&nbsp;<strong>queratina</strong>, que es la proteína que compone el 90% de tu cabello y uñas. Ayuda a que el pelo sea más resistente a las roturas.",
        "ggXmjLz4DnG_text_338072189": "100 mg",
        "gg8rzG6y-EL_srcSet_desktop_src_-1108364616": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_7.svg?v=1785434724",
        "gg8rzG6y-EL_srcSet_mobile_src_-537528795": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_14.webp?v=1786036007",
        "ggMG5YsCIGM_text_-771846035": "BIOTINA ( B7)",
        "gg7EU-Ve2Ep_text_1648341139": "Ayuda a metabolizar aminoácidos para que el cuerpo pueda producir queratina de manera eficiente. Una deficiencia de biotina debilita el pelo y descama las uñas.",
        "ggf24w6w_0I_text_515951835": "70 mg"
      }
    },
    "gp_global_section_634344275156402775-9": {
      "type": "gp-global-section-634344275156402775",
      "settings": {
        "section_preload": "false",
        "checksum": "",
        "ggL0xCRQJ6U_text_-304124760": "Efecto triple acción.",
        "gg7a3qJcpIF_text_7855456": "Para llegar donde ninguna otra formula llega.",
        "ggOYAWRGbkO_srcSet_desktop_src_1148383451": "https://placehold.co/1080x1000?text=Image",
        "ggOYAWRGbkO_srcSet_mobile_src_-421169342": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_5_1.webp?v=1786035297",
        "gg2UZYp0jDp_srcSet_desktop_src_-1192382118": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_10.svg?v=1785439331",
        "ggCNc1mGEow_childItem_0_-1470417884": "Acción Depurativa y Antioxidante",
        "gg2WVln95Ed_text_1530320069": "<strong>Tu cuero cabelludo se desinflama.</strong> La Cúrcuma apaga la microinflamación que tenía bloqueado al folículo, el Selenio <strong>protege las células capilares</strong> del daño diario y la Cola de Caballo aporta silicio orgánico que <strong>le devuelve grosor real a la hebra</strong>. El folículo queda abierto y receptivo, listo para absorber todo lo que viene después.",
        "ggoTY9uV-j2_srcSet_desktop_src_953161214": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_9.svg?v=1785439331",
        "ggEYzLdfFRb_childItem_0_1049214629": "Acción Hormonal y Antiestrés",
        "ggcFhGGA1bq_text_-32379584": "El Saw Palmetto <strong>bloquea la DHT</strong>, la hormona que venía miniaturizando tu folículo. La Ashwagandha <strong>baja el cortisol</strong>, evitando que tu cabello se caiga antes de tiempo. El ciclo capilar vuelve a su ritmo, <strong>sin minoxidil, sin fármacos, sin vello en zonas NO deseadas</strong>.",
        "ggTfl1CQWo-_srcSet_desktop_src_-679304417": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_8.svg?v=1785439331",
        "ggGI6BG_amg_childItem_0_-1229078780": "Acción Construcción y Estructural",
        "ggAwj-gBbKn_text_-1642479525": "<strong>Tu cabello se reconstruye desde la raíz.</strong> Los Péptidos de Colágeno le dan al folículo el material para <strong>producir hebras densas en lugar de finas.</strong> La L-Cisteína entra directo a la queratina y <strong>engrosa cada hebra</strong>. La Biotina hace que el cuerpo aproveche todo eso de forma eficiente. El cabello que crece aquí nace de un folículo sano: más grueso, más resistente, más difícil de romper.",
        "gghzsVcJurF_srcSet_desktop_src_1795848194": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/hampoos_12.svg?v=1785440321"
      }
    },

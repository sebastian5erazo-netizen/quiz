        "ggl0sfKat4p_text_-1090808188": "PASO 1",
        "gglnTpEcT-b_text_-1581986731": "Toma una capsula despues del desayuno",
        "ggusjvpkm3B_srcSet_desktop_src_1560823039": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/Image_22.webp?v=1785970176",

        "ggMROnSgNXO_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/images_1.jpg",
        "gg5PXpV8T-w_text": "Dermatologa. Luisa Peña",
        "ggf6Fi4nDU1_text": "<p>\"Pensé que no funcionaba, pero al segundo mes mi cabello mejoro muchísimo y dejo de caerse.\"</p>",
        "ggQhj-BuF_G_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/verificar.png?v=1785451553",
        "ggojgTlL9ju_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/103303202_2913563225359649_9191350915573692665_n.webp?v=1785446880",
        "ggfF6fylxzL_text": "Bety E.",
        "gg8QcXVq1Df_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/Diseno_sin_titulo_7.svg?v=1785429478",

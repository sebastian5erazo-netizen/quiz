        "gg2wHgMqDdW_text": "Dermatólogo. Camilo Torres",
        "ggBaD2SPIoY_text": "<p>\"Muchas gracias, me encanto el producto, de verdad que he utilizado muchísimos.\"</p>",
        "ggyKV69s7_N_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/verificar.png?v=1785451553",
        "gg4wl0Y1ZuP_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/Woman_taking_close-up_selfie_202607301742_1.webp?v=1785451389",
        "ggVjG71Gyxe_text": "Diana.C",
        "ggx3CzMj6o-_text": "<p>\"Totalmente recomendado, había probado de todo y nada, llevo 2 meses y mi cabello ha mejorado un montón.\"</p>",
        "gg3lRP7tzi-_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/verificar.png?v=1785451553",
        "gghCGlcXUXp_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/images.webp?v=1785446879",
        "ggvxq8nxb_3_text": "Doris Valencia.",
        "gglNZR5qt8G_text": "<p>\"Mis pacientas lo llevan, porque tiene garantía de resultados, pero NO la usan, jaja lo bueno es que funciona.\"</p>",
        "ggSVSXFwZvJ_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0767/8292/8103/files/verificar.png?v=1785451553",

<header class="site-header">
  <div class="site-header__row">
    <a href="{{ routes.search_url }}" class="site-header__icon-link" aria-label="{{ 'general.search' | t }}">
      {{ 'icon-search.svg' | inline_asset_content }}
    </a>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      <img
        src="https://cdn.shopify.com/s/files/1/0767/8292/8103/files/WhatsApp_Image_2026-04-21_at_4.33.52_PM_1.webp?v=1780624424"
        alt="{{ shop.name }}"
        width="180"
        height="48"
        loading="eager"
      >
    </a>

    <div class="site-header__icons">
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="site-header__icon-link">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="site-header__icon-link" aria-label="{{ 'general.cart' | t }}">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>

  {% if section.settings.menu.links.size > 0 %}
    <nav class="site-header__nav" aria-label="{{ 'general.main_menu' | t }}">
      <ul class="site-header__menu">
        {% for link in section.settings.menu.links %}
          <li>
            <a href="{{ link.url }}"{% if link.url == request.path %} aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</header>

{% stylesheet %}
  .site-header {
    background-color: var(--color-background);
  }

  .site-header__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 3.5rem;
    gap: 1rem;
  }

  .site-header__row > .site-header__icon-link {
    justify-self: start;
  }

  .site-header__logo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .site-header__logo img {
    height: 2rem;
    width: auto;
  }

  .site-header__icon-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .site-header__icon-link svg {
    width: 1.4rem;
  }

  .site-header__icon-link sup {
    position: absolute;
    top: -0.4rem;
    right: -0.6rem;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.2rem;
    border-radius: 999px;
    background-color: var(--color-brand-maroon);
    color: var(--color-brand-cream);
    font-size: 0.65rem;
    line-height: 1.1rem;
    text-align: center;
  }

  .site-header__icons {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__nav {
    display: flex;
    justify-content: center;
    padding-bottom: 0.9rem;
  }

  .site-header__menu {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-header__menu a {
    text-decoration: none;
    color: var(--color-foreground);
    font-size: 0.95rem;
  }

  .site-header__menu a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (max-width: 749px) {
    .site-header__menu {
      gap: 1.1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}

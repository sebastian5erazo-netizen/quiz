  letter-spacing:.4px;
  text-transform:uppercase;
  line-height:1.1;
}

.mf-exp__track{
  display:flex;
  gap:var(--mf-gap);
  overflow-x:auto;
  overflow-y:hidden;
  overscroll-behavior-x:contain;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
  padding:2px 2px 6px;
  cursor:grab;

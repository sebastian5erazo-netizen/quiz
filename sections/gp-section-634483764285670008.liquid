  color:#fff; cursor:pointer;
  transition:transform .15s ease, background .15s ease;
  z-index:3;
}
.mf-card__play:hover{ transform:translate(-50%,-50%) scale(1.06); background:rgba(0,0,0,.55); }
.mf-card__play svg{ width:26px; height:26px; margin-left:3px; fill:#fff; }
.mf-card.is-active .mf-card__play{ display:none; }
.mf-card.is-active.is-paused .mf-card__play{ display:flex; }

.mf-card__controls{
  position:absolute; left:0; right:0; bottom:0;
  display:flex; align-items:center; gap:9px;
  padding:14px 12px 12px;
  background:linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,0));
  opacity:0; pointer-events:none;
  transition:opacity .2s ease;
  z-index:2;
}
.mf-card.is-active .mf-card__controls{ opacity:1; pointer-events:auto; }

.mf-btn{
  flex:0 0 auto;
  display:flex; align-items:center; justify-content:center;
  width:26px; height:26px; padding:0;
  border:none; background:transparent; color:#fff; cursor:pointer;
}
.mf-btn svg{ width:20px; height:20px; fill:#fff; }

.mf-btn .mf-ico-play{ display:none; }
.mf-btn .mf-ico-pause{ display:block; }
.mf-card.is-paused .mf-btn .mf-ico-play{ display:block; }
.mf-card.is-paused .mf-btn .mf-ico-pause{ display:none; }
.mf-btn .mf-ico-mute{ display:none; }
.mf-card.is-muted .mf-btn .mf-ico-vol{ display:none; }
.mf-card.is-muted .mf-btn .mf-ico-mute{ display:block; }

.mf-progress{
  position:relative; flex:1 1 auto;
  padding:10px 0;
  cursor:pointer;
}
.mf-progress__bar{
  position:relative; height:6px; border-radius:99px;
  background:rgba(255,255,255,.32);
}
.mf-progress__fill{
  position:absolute; left:0; top:0; height:100%; width:0;

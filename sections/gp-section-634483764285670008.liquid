<script>
(function(){
  function fmt(s){ s=Math.max(0,s|0); var m=(s/60)|0, r=s%60; return m+':'+(r<10?'0'+r:r); }

  function init(root){
    if(root.dataset.mfReady) return; root.dataset.mfReady='1';
    var track = root.querySelector('.mf-exp__track');
    var cards = [].slice.call(root.querySelectorAll('.mf-card'));
    var active = null;
    var scrubbing = false;
    var vid = function(c){ return c.querySelector('.mf-card__video'); };

    function toPreview(card){
      var v = vid(card);
      card.classList.remove('is-active','is-paused','is-muted');
      v.loop = true; v.muted = true;
      var p = v.play(); if(p&&p.catch) p.catch(function(){});
      if(active===card) active=null;
    }

    function activate(card){
      if(active && active!==card) toPreview(active);
      active = card;
      var v = vid(card);
      card.classList.add('is-active');
      card.classList.remove('is-paused','is-muted');
      v.loop = false; v.muted = false;
      try{ v.currentTime = 0; }catch(e){}
      var p = v.play(); if(p&&p.catch) p.catch(function(){});
    }

    cards.forEach(function(card){
      var v      = vid(card);
      var big    = card.querySelector('.mf-card__play');
      var pp     = card.querySelector('.mf-btn--play');
      var mute   = card.querySelector('.mf-btn--mute');
      var prog   = card.querySelector('.mf-progress');
      var bar    = card.querySelector('.mf-progress__bar');
      var fill   = card.querySelector('.mf-progress__fill');
      var handle = card.querySelector('.mf-progress__handle');
      var time   = card.querySelector('.mf-time');

      big.addEventListener('click', function(e){
        e.stopPropagation();
        if(card.classList.contains('is-active')){ v.play(); }
        else { activate(card); }
      });

      card.addEventListener('click', function(){
        if(!card.classList.contains('is-active')){ activate(card); }
      });

      pp.addEventListener('click', function(e){
        e.stopPropagation();
        if(v.paused){ v.play(); } else { v.pause(); }
      });
      mute.addEventListener('click', function(e){
        e.stopPropagation();
        v.muted = !v.muted;
        card.classList.toggle('is-muted', v.muted);
      });

      v.addEventListener('play',  function(){ card.classList.remove('is-paused'); });
      v.addEventListener('pause', function(){ if(card.classList.contains('is-active')) card.classList.add('is-paused'); });
      v.addEventListener('ended', function(){ toPreview(card); });
      v.addEventListener('timeupdate', function(){
        if(scrubbing || !isFinite(v.duration) || !v.duration) return;
        var pct = (v.currentTime / v.duration) * 100;
        fill.style.width = pct + '%';
        handle.style.left = pct + '%';
        if(time) time.textContent = fmt(v.currentTime);
      });

      function seek(x){
        var r = bar.getBoundingClientRect();
        var p = Math.min(Math.max((x - r.left)/r.width, 0), 1);
        if(isFinite(v.duration) && v.duration>0){
          v.currentTime = p * v.duration;
          fill.style.width=(p*100)+'%'; handle.style.left=(p*100)+'%';
          if(time) time.textContent = fmt(v.currentTime);
        }
      }
      prog.addEventListener('pointerdown', function(e){
        e.stopPropagation(); e.preventDefault(); scrubbing=true;
        try{ prog.setPointerCapture(e.pointerId); }catch(_){}
        seek(e.clientX);
      });
      prog.addEventListener('pointermove', function(e){ if(scrubbing) seek(e.clientX); });
      prog.addEventListener('pointerup',   function(e){ scrubbing=false; try{ prog.releasePointerCapture(e.pointerId); }catch(_){} });
      prog.addEventListener('pointercancel', function(){ scrubbing=false; });
      prog.addEventListener('click', function(e){ e.stopPropagation(); e.preventDefault(); });

      card.querySelector('.mf-card__controls').addEventListener('pointerdown', function(e){ e.stopPropagation(); });
    });

    (function tick(){
      if(active && !scrubbing){
        var v = vid(active);
        if(v && isFinite(v.duration) && v.duration>0){
          var pct = (v.currentTime / v.duration) * 100;
          var f = active.querySelector('.mf-progress__fill');
          var h = active.querySelector('.mf-progress__handle');
          var t = active.querySelector('.mf-time');
          if(f) f.style.width = pct + '%';
          if(h) h.style.left  = pct + '%';
          if(t) t.textContent = fmt(v.currentTime);
        }
      }
      requestAnimationFrame(tick);
    })();

    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          var card = en.target, v = vid(card);
          if(en.isIntersecting){
            if(!card.classList.contains('is-active')){ var p=v.play(); if(p&&p.catch) p.catch(function(){}); }
          }else{
            if(card.classList.contains('is-active')) toPreview(card);
            v.pause();
          }
        });
      }, { threshold:0.4 });
      cards.forEach(function(c){ io.observe(c); });
    }else{
      cards.forEach(function(c){ var p=vid(c).play(); if(p&&p.catch) p.catch(function(){}); });
    }

    var down=false, startX=0, startScroll=0, moved=false;
    var lastX=0, lastT=0, vx=0, glide=null;
    function dragMove(e){
      var dx = e.clientX - startX;
      if(Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startScroll - dx;
      var now = performance.now(), dt = now - lastT;
      if(dt > 0) vx = (e.clientX - lastX) / dt;
      lastX = e.clientX; lastT = now;
      e.preventDefault();
    }
    function dragUp(){
      down = false;
      track.classList.remove('mf-dragging');
      window.removeEventListener('pointermove', dragMove);
      window.removeEventListener('pointerup', dragUp);
      var v = vx * 16;
      (function glideStep(){
        if(Math.abs(v) < 0.4){ glide = null; return; }
        track.scrollLeft -= v; v *= 0.94;
        glide = requestAnimationFrame(glideStep);
      })();
      setTimeout(function(){ moved = false; }, 0);
    }
    track.addEventListener('pointerdown', function(e){
      if(e.pointerType !== 'mouse') return;
      down = true; moved = false;
      startX = e.clientX; startScroll = track.scrollLeft;
      lastX = e.clientX; lastT = performance.now(); vx = 0;
      if(glide){ cancelAnimationFrame(glide); glide = null; }
      track.classList.add('mf-dragging');
      window.addEventListener('pointermove', dragMove);
      window.addEventListener('pointerup', dragUp);
    });
    track.addEventListener('click', function(e){ if(moved){ e.preventDefault(); e.stopPropagation(); } }, true);

    function step(dir){
      var w = cards[0] ? cards[0].getBoundingClientRect().width + 14 : 280;
      track.scrollBy({ left: dir*w, behavior:'smooth' });
    }
    var pv=root.querySelector('.mf-exp__nav--prev'), nx=root.querySelector('.mf-exp__nav--next');
    if(pv) pv.addEventListener('click', function(){ step(-1); });
    if(nx) nx.addEventListener('click', function(){ step(1); });
  }

  function boot(){ document.querySelectorAll('.mf-exp').forEach(init); }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', boot); }
  else{ boot(); }
})();
</script>
    </div>
    </div>
  
    </div>

      
    </gp-row>
  
  
    </div>

      
    </gp-row>
  
        </section>
      
  
    

{% comment %}
  Sección "Trata los síntomas desde adentro". Solo se conoce el encabezado
  por ahora; el contenido se añade por bloques cuando se confirme el diseño
  completo de la sección.
{% endcomment %}

<div
  class="symptoms full-width"
  style="--gradient-start: {{ section.settings.gradient_start }}; --gradient-end: {{ section.settings.gradient_end }};"
>
  <div class="symptoms__content">
    <h2 class="symptoms__title">{{ section.settings.heading }}</h2>

    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .symptoms {
    background: linear-gradient(160deg, var(--gradient-start) 0%, var(--gradient-end) 100%);
    padding-block: 4rem;
  }

  .symptoms__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .symptoms__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--color-brand-cream);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.symptoms",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Trata los síntomas desde adentro"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "t:labels.gradient_start",
      "default": "#6b2a24"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "t:labels.gradient_end",
      "default": "#2b1014"
    }
  ],
  "presets": [
    {
      "name": "t:general.symptoms"
    }
  ]
}
{% endschema %}

      data-keep-class="true"
      class="gAESepwf_t gp-custom-code">
      <div>
    <style>
/* ===== Carrusel Experiencias Reales ===== */
.mf-exp{
  /* 👇 CAMBIA SOLO ESTA LÍNEA para el color de la barra de reproducción */
  --mf-accent:#D46C23;

  --mf-radius:16px;
  --mf-gap:14px;
  --mf-card-w:260px;      /* ancho de tarjeta en desktop */
  --mf-title:#111;
  position:relative;
  width:100%;
  margin:0 auto;
  font-family:inherit;
  -webkit-tap-highlight-color:transparent;
}
.mf-exp *{ box-sizing:border-box; }

.mf-exp__title{
  margin:0 0 0px;
  color:var(--mf-title);
  font-size:clamp(20px,4vw,30px);
  font-weight:800;
  letter-spacing:.4px;
  text-transform:uppercase;
  line-height:1.1;
}

.mf-exp__track{
  display:flex;
  gap:var(--mf-gap);
  overflow-x:auto;
  overflow-y:hidden;
  overscroll-behavior-x:contain;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
  padding:2px 2px 6px;
  cursor:grab;
  user-select:none;
  -webkit-user-select:none;
}
.mf-exp__track::-webkit-scrollbar{ display:none; }
.mf-exp__track.mf-dragging{ cursor:grabbing; }

.mf-card{
  position:relative;
  flex:0 0 auto;
  width:var(--mf-card-w);
  aspect-ratio:9/16;
  border-radius:var(--mf-radius);
  overflow:hidden;
  background:#000;
  user-select:none;
}
@media (max-width:600px){
  .mf-exp{ --mf-card-w:76vw; }
}

.mf-card__video{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  background:#000;
  pointer-events:none;
}

.mf-card__play{
  position:absolute;
  top:50%; left:50%;
  transform:translate(-50%,-50%);
  width:62px; height:62px;
  display:flex; align-items:center; justify-content:center;
  border:none; border-radius:50%;
  background:rgba(0,0,0,.42);
  backdrop-filter:blur(2px);
  -webkit-backdrop-filter:blur(2px);
  color:#fff; cursor:pointer;
  transition:transform .15s ease, background .15s ease;
  z-index:3;
}
.mf-card__play:hover{ transform:translate(-50%,-50%) scale(1.06); background:rgba(0,0,0,.55); }
.mf-card__play svg{ width:26px; height:26px; margin-left:3px; fill:#fff; }
.mf-card.is-active .mf-card__play{ display:none; }
.mf-card.is-active.is-paused .mf-card__play{ display:flex; }

.mf-card__controls{
  position:absolute; left:0; right:0; bottom:0;
  display:flex; align-items:center; gap:9px;
  padding:14px 12px 12px;
  background:linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,0));
  opacity:0; pointer-events:none;
  transition:opacity .2s ease;
  z-index:2;
}
.mf-card.is-active .mf-card__controls{ opacity:1; pointer-events:auto; }

.mf-btn{
  flex:0 0 auto;
  display:flex; align-items:center; justify-content:center;
  width:26px; height:26px; padding:0;
  border:none; background:transparent; color:#fff; cursor:pointer;
}
.mf-btn svg{ width:20px; height:20px; fill:#fff; }

.mf-btn .mf-ico-play{ display:none; }
.mf-btn .mf-ico-pause{ display:block; }
.mf-card.is-paused .mf-btn .mf-ico-play{ display:block; }
.mf-card.is-paused .mf-btn .mf-ico-pause{ display:none; }
.mf-btn .mf-ico-mute{ display:none; }
.mf-card.is-muted .mf-btn .mf-ico-vol{ display:none; }
.mf-card.is-muted .mf-btn .mf-ico-mute{ display:block; }

.mf-progress{
  position:relative; flex:1 1 auto;
  padding:10px 0;
  cursor:pointer;
}
.mf-progress__bar{
  position:relative; height:6px; border-radius:99px;
  background:rgba(255,255,255,.32);
}
.mf-progress__fill{
  position:absolute; left:0; top:0; height:100%; width:0;
  background:#D46C23 !important;
  background:var(--mf-accent,#D46C23) !important;
  border-radius:99px;
  transition:width .08s linear;
}
.mf-progress__handle{
  position:absolute; top:50%; left:0;
  width:13px; height:13px; border-radius:50%;
  background:#D46C23 !important;
  background:var(--mf-accent,#D46C23) !important;
  transform:translate(-50%,-50%);
  box-shadow:0 0 0 3px rgba(0,0,0,.25);
  transition:left .08s linear;
  z-index:2;
}

.mf-time{
  flex:0 0 auto; color:#fff; font-size:11px;
  font-variant-numeric:tabular-nums; opacity:.9; min-width:34px; text-align:center;
}

.mf-card__caption{
  position:absolute; left:0; right:0; bottom:16px;
  text-align:center; color:#fff; font-weight:600;
  font-size:clamp(15px,2.4vw,20px);
  text-shadow:0 1px 6px rgba(0,0,0,.55);
  padding:0 14px; z-index:1; pointer-events:none;
}
.mf-card.is-active .mf-card__caption{ opacity:0; transition:opacity .2s; }

.mf-exp__nav{
  position:absolute; top:calc(50% + 16px);
  transform:translateY(-50%);
  width:40px; height:40px; border-radius:50%;

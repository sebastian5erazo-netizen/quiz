    <!--
  ============================================================
  SECCION: "Tu transformacion en 90 dias" — VERSION FINAL
  (replica exacta del diseno de Claude Design)
  Donde pegarla:
    - GemPages: elemento Codigo Personalizado -> pestana HTML/Liquid
    - O en el tema de Shopify: Agregar seccion -> Custom Liquid
    (funciona igual en ambos: no tiene etiquetas Liquid)
  Que editar:
    - COLORES: variables --srn-* al inicio del <style>
    - TEXTOS: las pills "DIA X: ..." y los stats de cada tarjeta
    - Para agregar/quitar hitos: duplica o borra un bloque
      completo con data-srn-item. La animacion se ajusta sola.
  ============================================================
-->

<style>
  #srn-journey-final {
    /* ---------- EDITA AQUI LOS COLORES ---------- */
    --srn-accent: #7F1201;              /* vino tinto: pills, linea, stats */
    --srn-bg: #FBF0EF;                  /* crema de fondo */
    --srn-card-bg: #FFFFFF;             /* fondo de tarjetas */
    --srn-card-border: rgba(127,18,1,0.18);
    --srn-line: rgba(127,18,1,0.22);    /* linea sin llenar */
    --srn-pill-text: #FBF0EF;           /* texto dentro de la pill */
    /* -------------------------------------------- */

    background: var(--srn-bg);
    padding: 56px 20px;
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif;
    color: #541005;
  }
  #srn-journey-final .srn-jf__list {
    max-width: 620px;
    margin: 0 auto;
    position: relative;
    padding-left: 52px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  #srn-journey-final .srn-jf__track {
    position: absolute;
    left: 18px; top: 10px; bottom: 10px;
    width: 3px;
    border-radius: 3px;
    background: var(--srn-line);
  }
  #srn-journey-final .srn-jf__fill {
    position: absolute;
    left: 18px; top: 10px;
    width: 3px;
    height: 0;
    border-radius: 3px;
    background: var(--srn-accent);
    z-index: 1;
    transition: height .25s ease-out;
  }
  #srn-journey-final [data-srn-item] {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0.35;
    transform: translateY(10px);
    transition: opacity .5s ease, transform .5s ease;
  }
  #srn-journey-final [data-srn-item].is-active {
    opacity: 1;
    transform: translateY(0);
  }
  #srn-journey-final .srn-jf__marker {
    position: absolute;
    left: -52px; top: 4px;
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: var(--srn-bg);
    border-radius: 50%;
    z-index: 4;
    transition: transform .4s ease;
  }
  #srn-journey-final [data-srn-item].is-active .srn-jf__marker { transform: scale(1.1); }
  #srn-journey-final .srn-jf__marker img {
    width: 30px; height: 30px; display: block;
    opacity: 0.32;
    transition: opacity .4s ease;
  }
  #srn-journey-final [data-srn-item].is-active .srn-jf__marker img { opacity: 1; }
  #srn-journey-final .srn-jf__pill {
    align-self: flex-start;
    display: flex; align-items: center;
    background: var(--srn-accent);
    border-radius: 999px;
    padding: 9px 18px;
    box-shadow: 0 2px 8px rgba(84,16,5,0.18);
  }
  #srn-journey-final .srn-jf__pill span {
    color: var(--srn-pill-text);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  #srn-journey-final .srn-jf__card {
    background: var(--srn-card-bg);
    border: 1px solid var(--srn-card-border);
    border-radius: 10px;
    padding: 16px 20px;
    font-size: 15px;
    line-height: 1.5;
    font-style: italic;
    text-wrap: pretty;
  }
  #srn-journey-final .srn-jf__card strong {
    font-weight: 700;
    color: var(--srn-accent);
    font-style: italic;
  }
  @media (prefers-reduced-motion: reduce) {
    #srn-journey-final * { transition: none !important; }
  }
</style>

<section id="srn-journey-final">
  <div class="srn-jf__list" data-srn-list>
    <span class="srn-jf__track" aria-hidden="true"></span>
    <span class="srn-jf__fill" aria-hidden="true" data-srn-fill></span>


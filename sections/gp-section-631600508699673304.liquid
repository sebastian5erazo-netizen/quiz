<script>
  (function () {
    var section = document.getElementById('srn-journey-final');
    if (!section) return;
    var list = section.querySelector('[data-srn-list]');
    var fill = section.querySelector('[data-srn-fill]');
    var items = Array.prototype.slice.call(section.querySelectorAll('[data-srn-item]'));
    if (!list || !fill || !items.length) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var activated = items.map(function () { return false; });

    /* Punto de activacion: cuando un hito cruza el 65% de la pantalla, se desbloquea.
       Sube este numero (ej. 0.8) para que se desbloqueen mas abajo,
       o bajalo (ej. 0.5) para que se desbloqueen antes. */
    var ANCHOR = 0.65;

    function update() {
      var rect = list.getBoundingClientRect();
      var anchor = window.innerHeight * ANCHOR;
      var max = Math.max(0, rect.height - 20);

      /* La linea se llena de forma continua siguiendo el scroll */
      var progress = anchor - rect.top - 10;
      var height = Math.max(0, Math.min(progress, max));
      fill.style.height = height + 'px';

      /* Cada hito se desbloquea cuando la linea llega a su marcador (y no se vuelve a apagar) */
      items.forEach(function (item, i) {
        if (activated[i]) return;
        var marker = item.querySelector('.srn-jf__marker');
        var mRect = marker.getBoundingClientRect();
        if (mRect.top + mRect.height / 2 <= anchor) {
          activated[i] = true;
          item.classList.add('is-active');
        }
      });
    }

    function activateAll() {
      activated = activated.map(function () { return true; });
      fill.style.height = Math.max(0, list.offsetHeight - 20) + 'px';
      items.forEach(function (i) { i.classList.add('is-active'); });
    }

    if (reduceMotion) {
      activateAll();
      return;
    }

    var ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(function () { update(); ticking = false; });
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    /* Correr una vez al cargar por si la seccion ya esta visible */
    update();
  })();
</script>

{% comment %}
  Renders a top announcement bar with one or more rotating messages.
  All messages are present in the initial HTML; only their visibility is
  toggled client-side, so the content stays readable with JavaScript off.
{% endcomment %}

<announcement-bar class="announcement-bar full-width">
  <div class="announcement-bar__row">
    <button
      type="button"
      class="announcement-bar__control announcement-bar__control--prev"
      aria-label="{{ 'accessibility.previous' | t }}"
      {% if section.blocks.size <= 1 %}
        hidden
      {% endif %}
    >
      &lsaquo;
    </button>

    <ul class="announcement-bar__list">
      {% for block in section.blocks %}
        <li
          class="announcement-bar__item"
          {% unless forloop.first %}
            hidden
          {% endunless %}
          {{ block.shopify_attributes }}
        >
          {{ block.settings.text }}
        </li>
      {% endfor %}
    </ul>

    <button
      type="button"
      class="announcement-bar__control announcement-bar__control--next"
      aria-label="{{ 'accessibility.next' | t }}"
      {% if section.blocks.size <= 1 %}
        hidden
      {% endif %}
    >
      &rsaquo;
    </button>
  </div>
</announcement-bar>

{% stylesheet %}
  .announcement-bar {
    background-color: var(--color-brand-maroon-darkest);
    color: var(--color-brand-cream);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .announcement-bar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 0.35rem var(--page-margin);
  }

  .announcement-bar__list {
    flex: 1;
    text-align: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .announcement-bar__item[hidden] {
    display: none;
  }

  .announcement-bar__control {
    flex: none;
    background: none;
    border: none;
    color: inherit;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.15rem 0.5rem;
  }

  .announcement-bar__control[hidden] {
    visibility: hidden;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('announcement-bar')) {
    customElements.define(
      'announcement-bar',
      class AnnouncementBar extends HTMLElement {
        connectedCallback() {
          this.items = Array.from(this.querySelectorAll('.announcement-bar__item'));
          this.index = 0;

          const prevButton = this.querySelector('.announcement-bar__control--prev');
          const nextButton = this.querySelector('.announcement-bar__control--next');

          prevButton?.addEventListener('click', () => this.show(this.index - 1));
          nextButton?.addEventListener('click', () => this.show(this.index + 1));
        }

        show(index) {
          const total = this.items.length;
          if (!total) return;

          this.index = (index + total) % total;
          this.items.forEach((item, i) => {
            item.hidden = i !== this.index;
          });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "blocks": [
    {
      "type": "message",
      "name": "t:general.message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Envíos a todo Colombia"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.announcement_bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Envíos a todo Colombia"
          }
        }
      ]
    }
  ]
}
{% endschema %}

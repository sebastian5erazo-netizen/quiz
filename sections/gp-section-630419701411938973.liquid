<script>
(function(){

function initFungiGallery(){

    var galleries=document.querySelectorAll(".fungi-gal");

    galleries.forEach(function(gallery){

        if(gallery.dataset.fungiReady==="1"){return;}
        gallery.dataset.fungiReady="1";

        var slider=gallery.querySelector(".fungi-gal-main");
        var slides=Array.prototype.slice.call(gallery.querySelectorAll(".fungi-gal-slide"));
        var thumbs=Array.prototype.slice.call(gallery.querySelectorAll(".fungi-gal-thumb"));

        if(!slider||!slides.length){return;}

        function offsetFor(i){
            return slides[i].offsetLeft-slides[0].offsetLeft;
        }

        function setActive(i){
            thumbs.forEach(function(t,n){
                t.classList.toggle("is-active",n===i);
            });
        }

        thumbs.forEach(function(thumb,index){
            thumb.addEventListener("click",function(){
                slider.scrollTo({left:offsetFor(index),behavior:"smooth"});
                setActive(index);
            });
        });

        var ticking=false;

        slider.addEventListener("scroll",function(){
            if(ticking){return;}
            ticking=true;
            window.requestAnimationFrame(function(){
                ticking=false;
                var pos=slider.scrollLeft;
                var best=0;
                var bestDist=Infinity;
                for(var i=0;i<slides.length;i++){
                    var d=Math.abs(offsetFor(i)-pos);
                    if(d<bestDist){bestDist=d;best=i;}
                }
                setActive(best);
            });
        },{passive:true});

    });

}

if(document.readyState==="loading"){
    document.addEventListener("DOMContentLoaded",initFungiGallery);
}else{
    initFungiGallery();
}

})();
</script>

    <style>
.fungi-gal{
    --fungi-radius:8px;
    --fungi-active:#7F4C34;
    width:100%;
}

.fungi-gal-main{
    display:flex;
    overflow-x:auto;
    gap:0;
    scroll-snap-type:x mandatory;
    scroll-behavior:smooth;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
}

.fungi-gal-main::-webkit-scrollbar{
    display:none;
}

.fungi-gal-slide{
    flex:0 0 100%;
    scroll-snap-align:center;
}

.fungi-gal-slide img{
    width:100%;
    height:auto;
    display:block;
    aspect-ratio:1/1;
    object-fit:cover;
    border-radius:var(--fungi-radius);
}

.fungi-gal-thumbs{
    display:grid;
    grid-template-columns:repeat(9,1fr);
    gap:8px;
    margin-top:14px;
}

.fungi-gal-thumb{
    border-radius:var(--fungi-radius);
    overflow:hidden;
    cursor:pointer;
    border:2px solid transparent;
    transition:border-color .25s;
    padding:0;
    background:none;
    display:block;
    width:100%;
}

.fungi-gal-thumb.is-active{
    border-color:var(--fungi-active);
}

.fungi-gal-thumb:focus-visible{
    outline:2px solid var(--fungi-active);
    outline-offset:2px;
}

.fungi-gal-thumb img{
    width:100%;
    height:auto;
    display:block;
    aspect-ratio:1/1;
    object-fit:cover;
}

@media(prefers-reduced-motion:reduce){
    .fungi-gal-main{
        scroll-behavior:auto;
    }
}

@media(max-width:768px){

.fungi-gal-main{
    padding:0 16px;
    gap:12px;
}

.fungi-gal-slide{
    flex:0 0 calc(100% - 32px);
}

.fungi-gal-thumbs{
    display:none;
}

}
</style>

